<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The org metapom — consolidates the Spring Boot 4.0.7 / Spring Cloud 2025.1.2 / Java 25 LTS reactive BFF
       baseline (WebFlux + Casdoor OAuth2 resource server + R2DBC/Liquibase +
       SpringDoc) as shared <dependencies>, the dependencyManagement
       (hugmesh-commons, AWS SDK BOM, resilience4j, springdoc version pins), and the
       pluginManagement (compiler / surefire bytebuddy flag / spring-boot / native).
       hugmesh-parent is itself a child of spring-boot-starter-parent:3.5.5, so the
       Spring Boot dependency + plugin management is inherited TRANSITIVELY. -->
  <parent>
    <groupId>systems.hugmesh</groupId>
    <artifactId>hugmesh-parent</artifactId>
    <version>2.8.0</version>
    <relativePath/>
  </parent>

  <!-- NO -api suffix in the artifactId; the -api lives only in the repo / service
       / image name (hugmesh-mesh-bff-api), mirroring mod-bff/admin-bff. -->
  <artifactId>mesh-bff</artifactId>
  <version>0.1.0</version>

  <dependencies>
    <!-- The shared, canonical HugMesh security/tenancy/config/web building blocks
         (Casdoor JWT authorities, issuer->domain DomainRegistry, Roles + PrincipalDomain
         helpers, the config-gated multi-issuer TenancyResourceServerConfig, the BFF
         ApiException). Version is MANAGED by hugmesh-parent's dependencyManagement,
         so NO <version> here. -->
    <dependency>
      <groupId>net.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
    </dependency>

    <!-- commons test-support base classes (PostgresTestSupport) for full-context
         Testcontainers-backed integration tests. -->
    <dependency>
      <groupId>net.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
      <version>2.1.0</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>

    <!-- Spring Boot 4 split out the reactive WebClient auto-configuration (the
         WebClient.Builder bean) into spring-boot-webclient — it is NO LONGER a
         transitive of spring-boot-starter-webflux. This repo's outbound client
         (user-bff's internal mesh-devices surface) injects WebClient.Builder, so the
         module must be on the classpath. Version is Boot-BOM-managed via the parent,
         so no <version> here. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webclient</artifactId>
    </dependency>

    <!-- ============================================================================
         The core reactive BFF stack (webflux / actuator / security /
         oauth2-resource-server / validation), the data-access stack (data-r2dbc /
         r2dbc-postgresql / liquibase-core / spring-jdbc / postgresql), springdoc and
         the whole test stack (spring-boot-starter-test / reactor-test /
         spring-security-test / r2dbc-h2 / h2) are INHERITED from hugmesh-parent's
         common <dependencies>. ONLY the repo-specific dependencies below remain.
         ============================================================================ -->

    <!-- resilience4j circuit breaker (reactive) — guards the Postgres/Cassandra cache
         reload legs (node directory + devices-mine) and the outbound user-bff call.
         Repo-specific (NOT in the parent's common <dependencies>); version is
         MANAGED by hugmesh-parent's dependencyManagement so no <version> here.
         DELIBERATELY no resilience4j-spring-boot4 here (unlike mod-bff-api, which
         uses the @CircuitBreaker AOP-annotation mechanism that module provides): this
         repo exclusively uses the ReactiveCircuitBreakerFactory/Customizer shape
         (config.CacheResilienceConfig, cloned from hugmesh-gateway's
         GatewayResilienceConfig), and resilience4j-spring-boot4's auto-configuration
         collides with spring-cloud-starter-circuitbreaker-reactor-resilience4j's own
         transitive resilience4j-spring-boot3 auto-configuration (both register a bean
         named bulkheadRegistryEventConsumer) — a real
         BeanDefinitionOverrideException at context boot, live-verified via
         `./mvnw test`. resilience4j-reactor alone supplies the CircuitBreakerConfig /
         TimeLimiterConfig types CacheResilienceConfig needs. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
    </dependency>
    <!-- ReactiveCircuitBreaker / ReactiveCircuitBreakerFactory (Spring Cloud's
         abstraction over resilience4j) — the exact type GatewayRouteAccessService
         uses; version is Spring-Cloud-BOM-managed via the parent's
         spring-cloud-dependencies import, so no <version> here either. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>

    <!-- Raw DataStax/Apache Cassandra Java driver — the best-effort write-through
         mirror + fallback-read leg for the node-directory cache (mesh_node_directory
         + mesh_room), cloned from hugmesh-admin-bff-api's
         routeaccess/CassandraRouteMirror.java + cassandra/CassandraSessionFactory.java
         shape. Deliberately the SAME client stack admin-bff uses (not the
         spring-boot-starter-data-cassandra-reactive gateway uses for its OWN mirror) —
         one Cassandra client stack in this small BFF, not two. Version pinned to match
         admin-bff-api's pin so the two Cassandra-writer services stay on the same wire
         protocol version. -->
    <dependency>
      <groupId>org.apache.cassandra</groupId>
      <artifactId>java-driver-core</artifactId>
      <version>4.19.3</version>
    </dependency>
  </dependencies>

  <build><plugins>
    <!-- The spring-boot, native and surefire (bytebuddy-experimental argLine)
         plugins are configured in hugmesh-parent's pluginManagement; declaring
         them here (no config) binds the managed config. The native plugin is bound
         so `./mvnw -Pnative native:compile` works; spring-boot repackages the app. -->
    <plugin>
      <groupId>org.graalvm.buildtools</groupId>
      <artifactId>native-maven-plugin</artifactId>
    </plugin>
    <plugin>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-maven-plugin</artifactId>
    </plugin>
  </plugins></build>

  <profiles>
    <!-- Native build: `./mvnw -Pnative native:compile` produces a GraalVM binary.
         The parent's native plugin management does the heavy lifting; this thin
         local profile mirrors mod-bff/admin-bff/federation so the same `-Pnative`
         invocation works. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
